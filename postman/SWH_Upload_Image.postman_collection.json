{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-swhuploadimage",
    "name": "SWH Upload Image",
    "description": "Login → Upload image → get imageUrl + qrcodeUrl (2h TTL).\nAccess token 7d; on TOKEN_EXPIRED use Refresh Token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://swhimage.ice-solution.hk" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "admin123" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "uploadId", "value": "" },
    { "key": "imageUrl", "value": "" },
    { "key": "qrcodeUrl", "value": "" },
    { "key": "themeId", "value": "" },
    { "key": "queryDate", "value": "2026-06-15" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Optional. Skip if user already exists."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Returns accessToken (7d) + refreshToken. Tokens are saved to collection variables."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh success', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/refresh",
            "description": "Call when upload/API returns code TOKEN_EXPIRED."
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "2. Upload Flow",
      "item": [
        {
          "name": "Upload Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Upload success', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.imageUrl).to.be.a('string');",
                  "  pm.expect(json.data.qrcodeUrl).to.be.a('string');",
                  "  pm.collectionVariables.set('uploadId', json.data.id);",
                  "  pm.collectionVariables.set('imageUrl', json.data.imageUrl);",
                  "  pm.collectionVariables.set('qrcodeUrl', json.data.qrcodeUrl);",
                  "});",
                  "",
                  "if (pm.response.code === 401) {",
                  "  const json = pm.response.json();",
                  "  if (json.code === 'TOKEN_EXPIRED') {",
                  "    console.log('Access token expired — run Auth / Refresh Token, then retry Upload.');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Select a jpeg/png/gif/webp file (max 10MB)"
                }
              ]
            },
            "url": "{{baseUrl}}/api/upload",
            "description": "Multipart field name must be `image`. Response includes imageUrl + qrcodeUrl (valid 2 hours)."
          }
        },
        {
          "name": "Get Upload by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/upload/{{uploadId}}"
          }
        },
        {
          "name": "Open Image URL",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{imageUrl}}",
            "description": "Public file URL (no JWT). Expires after 2 hours."
          }
        },
        {
          "name": "Open QR Code URL",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{qrcodeUrl}}",
            "description": "QR encodes imageUrl. Public, expires after 2 hours."
          }
        }
      ]
    },
    {
      "name": "3. Theme / Phase",
      "item": [
        {
          "name": "Get Current Theme",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current theme has phase 1|2|3', function () {",
                  "  if (pm.response.code === 404) { return; }",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect([1, 2, 3]).to.include(json.data.phase);",
                  "  pm.collectionVariables.set('themeId', json.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/theme/current",
            "description": "Resolve phase from today's date (non-overlapping ranges)."
          }
        },
        {
          "name": "Get Theme by Date",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/theme/current?date={{queryDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "theme", "current"],
              "query": [
                { "key": "date", "value": "{{queryDate}}", "description": "YYYY-MM-DD" }
              ]
            },
            "description": "Resolve phase for a specific date."
          }
        },
        {
          "name": "List Themes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/theme"
          }
        },
        {
          "name": "Create Theme",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('themeId', json.data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phase\": 1,\n  \"start_date\": \"2026-01-01\",\n  \"end_date\": \"2026-04-30\"\n}"
            },
            "url": "{{baseUrl}}/api/theme",
            "description": "phase must be 1, 2, or 3. Date ranges must not overlap."
          }
        },
        {
          "name": "Get Theme by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/theme/{{themeId}}"
          }
        },
        {
          "name": "Update Theme",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phase\": 2,\n  \"start_date\": \"2026-05-01\",\n  \"end_date\": \"2026-08-31\"\n}"
            },
            "url": "{{baseUrl}}/api/theme/{{themeId}}"
          }
        },
        {
          "name": "Delete Theme",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/theme/{{themeId}}"
          }
        }
      ]
    },
    {
      "name": "4. Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    }
  ]
}
